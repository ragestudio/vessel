{
	"name": "@ragestudio/vessel",
	"version": "0.30.0",
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"repository": "https://github.com/ragestudio/vessel.git",
	"author": "RageStudio",
	"license": "MIT",
	"files": [
		"src",
		"dist"
	],
	"publishConfig": {
		"access": "public"
	},
	"scripts": {
		"build": "tsc"
	},
	"peerDependencies": {
		"react": "^19.2.7",
		"react-dom": "^19.2.7",
		"react-router": "^7.18.0"
	},
	"dependencies": {
		"@gullerya/object-observer": "^7.0.0",
		"@loadable/component": "^5.16.7",
		"comlink": "^4.4.2",
		"localforage": "^1.10.0",
		"prop-types": "^15.8.1"
	},
	"devDependencies": {
		"@types/loadable__component": "^5.13.10",
		"@types/prop-types": "^15.7.15",
		"@types/react": "^19.2.18",
		"@types/react-dom": "^19.3.0",
		"typescript": "^7.0.2",
		"vite": "^8.2.2"
	},
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"default": "./dist/index.js"
		},
		"./core": {
			"types": "./dist/core.d.ts",
			"default": "./dist/core.js"
		},
		"./runtime": {
			"types": "./dist/runtime.d.ts",
			"default": "./dist/runtime.js"
		},
		"./types": {
			"types": "./dist/types.d.ts",
			"default": "./dist/types.js"
		},
		"./adapter": {
			"types": "./dist/adapter.d.ts",
			"default": "./dist/adapter.js"
		},
		"./extension": {
			"types": "./dist/extension.d.ts",
			"default": "./dist/extension.js"
		},
		"./extensions": {
			"types": "./dist/extensions.d.ts",
			"default": "./dist/extensions.js"
		},
		"./router": {
			"types": "./dist/router/index.d.ts",
			"default": "./dist/router/index.js"
		},
		"./adapters/react": {
			"types": "./dist/adapters/react/index.d.ts",
			"default": "./dist/adapters/react/index.js"
		},
		"./adapters/react-native": {
			"types": "./dist/adapters/react-native/react-native.d.ts",
			"default": "./dist/adapters/react-native/react-native.js"
		},
		"./classes/*": {
			"types": "./dist/classes/*/index.d.ts",
			"default": "./dist/classes/*/index.js"
		},
		"./utils/*": {
			"types": "./dist/utils/*.d.ts",
			"default": "./dist/utils/*.js"
		},
		"./package.json": "./package.json"
	}
}
